PORT=3000
NODE_ENV=development

# Panel de Supabase -> Project Settings -> API
# SUPABASE_URL debe ser la URL completa: https://<ref>.supabase.co
SUPABASE_URL=https://TU-PROYECTO.supabase.co
# SUPABASE_KEY es la clave "anon public" (un JWT largo que empieza por eyJ...)
# NO es la contrasena de la base de datos.
SUPABASE_KEY=eyJ...

# Clave con la que se firma el JWT que viaja dentro de la cookie.
# Cambiala por una cadena larga y aleatoria.
JWT_SECRET=cambia-esto-por-algo-largo-y-aleatorio

# Origen exacto del frontend. Con cookies el CORS no puede ser '*'.
# Se pueden poner varios separados por coma.
FRONTEND_URL=http://localhost:5173

# 'true' solo si el frontend queda en un dominio distinto al backend
# (entonces la cookie necesita SameSite=None + Secure, o sea HTTPS).
CROSS_SITE_COOKIES=false
